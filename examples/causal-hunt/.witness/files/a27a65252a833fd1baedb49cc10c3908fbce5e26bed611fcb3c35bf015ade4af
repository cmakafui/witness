import json,os,numpy as np
d=json.load(open("q-21c8ae2c8fd4/moments.json"));assert os.path.getsize("q-21c8ae2c8fd4/correlations.png")>0
m=np.array(d["mean"]);c=np.array(d["cov"]);pred=[]
for order in [list(range(6)),list(reversed(range(6)))]:
 B=np.zeros((6,6))
 for k,j in enumerate(order):
  p=order[:k]
  if p:B[j,p]=np.linalg.solve(c[np.ix_(p,p)],c[p,j])
 a=m-B@m;y=np.zeros(6)
 for j in order:y[j]=2 if j==0 else a[j]+B[j]@y
 pred.append(y)
json.dump({"predictions":[a.tolist() for a in pred]},open(os.environ["WITNESS_OUT"]+"/ambiguous_predictions.json","w"))
print("WITNESS_RESULT",json.dumps({"forward":pred[0].tolist(),"reverse":pred[1].tolist(),"max_gap":float(np.max(np.abs(pred[0][1:]-pred[1][1:])))}))
print("WITNESS_ANSWER","yes" if np.max(np.abs(pred[0][1:]-pred[1][1:]))<=.3 else "no")
