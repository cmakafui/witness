import numpy as np,json,os,itertools
import matplotlib;matplotlib.use('Agg')
import matplotlib.pyplot as plt
names=['x1','x2','x3','x4','x5','x6']
def read(p):
 x=np.genfromtxt(p,delimiter=',',names=True);a=np.column_stack([x[n] for n in names]);assert len(a)>=100 and a.shape[1]==6;return a
obs=read('observational.csv');exps=[read(f'data/exp{i}.csv') for i in range(2,6)];mu=obs.mean(0);delta=np.array([a.mean(0)-mu for a in exps]);parents=[1,2,3,5];design=delta[:,parents];assert np.linalg.matrix_rank(design)==4
coef=np.linalg.solve(design,delta[:,0]);b=np.zeros((6,6));b[0,parents]=coef
for j,p in [(2,1),(3,2),(4,1),(5,4)]:b[j,p]=np.cov(obs[:,j],obs[:,p])[0,1]/np.var(obs[:,p],ddof=1)
alpha=mu-b@mu;res=obs-obs@b.T-alpha;cor=np.corrcoef(res,rowvar=False);pairs=sorted([{'pair':[names[i],names[j]],'correlation':float(cor[i,j])} for i,j in itertools.combinations(range(6),2)],key=lambda r:-abs(r['correlation']));edges=[[names[i],names[j]] for j,i in zip(*np.nonzero(b))];out=os.environ['WITNESS_OUT'];result={'edges':edges,'confounded':[['x1','x2']],'B':b.tolist(),'intercept':alpha.tolist(),'residual_correlations':pairs,'residual_covariance':np.cov(res,rowvar=False).tolist(),'condition_number':float(np.linalg.cond(design))};json.dump(result,open(out+'/revised_graph_confounding.json','w'),indent=2);np.save(out+'/structural_residuals.npy',res)
fig,ax=plt.subplots(figsize=(7,6));im=ax.imshow(cor,vmin=-1,vmax=1,cmap='coolwarm');ax.set_xticks(range(6),names);ax.set_yticks(range(6),names)
for i in range(6):
 for j in range(6):ax.text(j,i,f'{cor[i,j]:.2f}',ha='center',va='center')
fig.colorbar(im);fig.tight_layout();fig.savefig(out+'/structural_residuals.png')
print('WITNESS_RESULT',json.dumps(result));print('WITNESS_ANSWER','yes' if abs(cor[0,1])>.3 and all(abs(cor[i,j])<.15 for i,j in itertools.combinations(range(6),2) if (i,j)!=(0,1)) and all(abs(b[j,i])>.1 for j,i in zip(*np.nonzero(b))) else 'no')