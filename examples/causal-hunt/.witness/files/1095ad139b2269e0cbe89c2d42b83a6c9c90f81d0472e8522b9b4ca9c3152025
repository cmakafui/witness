# requires-python = ">=3.11"
# dependencies = ["numpy==2.3.4", "scipy==1.16.3"]
# ///
import os,sys,json,itertools,shutil,numpy as np
sys.path.insert(0,"scratch");from joint_fit import fit
files=["observational.csv"]+[f"data/exp{i}.csv" for i in range(1,7)]
fixed=[{}, {0:2},{3:3},{2:-3},{1:3},{4:3},{5:-3}]
regimes=[]
for fn,d in zip(files,fixed):
 x=np.loadtxt(fn,delimiter=",",skiprows=1);assert x.shape==(2000 if not d else 500,6)
 for j,v in d.items():assert np.allclose(x[:,j],v)
 regimes.append((x,d))
order=[1,2,3,4,5,0];full=[(a,b) for k,a in enumerate(order) for b in order[k+1:]]
candidates=[]
for pair in [None]+list(itertools.combinations(range(6),2)):
 edges=full.copy();res=fit(regimes,edges,pair)
 while edges:
  trials=[]
  for edge in edges:
   ee=[e for e in edges if e!=edge];rr=fit(regimes,ee,pair);trials.append((rr["bic"],ee,rr))
  score,ee,rr=min(trials,key=lambda z:z[0])
  if score>=res["bic"]-1e-6:break
  edges,res=ee,rr
 for edge in full:
  if edge not in edges:
   ee=edges+[edge];rr=fit(regimes,ee,pair)
   if rr["bic"]<res["bic"]-1e-6:edges,res=ee,rr
 candidates.append({"pair":pair,"edges":edges,**res})
candidates.sort(key=lambda z:z["bic"]);best=candidates[0]
def serial(d):return {k:(v.tolist() if isinstance(v,np.ndarray) else v) for k,v in d.items()}
out=os.environ["WITNESS_OUT"];json.dump([serial(d) for d in candidates],open(out+"/candidate_fits.json","w"),indent=2)
B=best["B"];a=best["a"];pred=[];errors=[]
for x,d in regimes:
 y=np.zeros(6)
 for j in order:y[j]=d[j] if j in d else a[j]+B[j]@y
 er=[float(abs(y[j]-x[:,j].mean())) for j in range(6) if j not in d];errors+=er;pred.append({"do":d,"prediction":y.tolist(),"empirical":x.mean(0).tolist(),"errors":er})
json.dump(pred,open(out+"/regime_predictions.json","w"),indent=2)
graph={"edges":[[f"x{i+1}",f"x{j+1}"] for i,j in best["edges"]],"confounded":[] if best["pair"] is None else [[f"x{i+1}" for i in best["pair"]]]}
json.dump(graph,open(out+"/graph.json","w"),indent=2)
source="import numpy as np\n\n_B = np.array("+repr(B.tolist())+")\n_A = np.array("+repr(a.tolist())+")\n_ORDER = "+repr(order)+"\n_GRAPH = "+repr(graph)+"\n\ndef graph():\n    return {k: [list(e) for e in v] for k, v in _GRAPH.items()}\n\ndef intervene(do):\n    y = np.zeros(6)\n    for j in _ORDER:\n        name = 'x' + str(j + 1)\n        y[j] = float(do[name]) if name in do else _A[j] + _B[j] @ y\n    return {'x' + str(j + 1): float(y[j]) for j in range(6)}\n"
open(out+"/model.py","w").write(source);shutil.copyfile("scratch/joint_fit.py",out+"/joint_fit.py")
gap=candidates[1]["bic"]-best["bic"]
print("WITNESS_RESULT",json.dumps({"graph":graph,"B":B.tolist(),"intercepts":a.tolist(),"residual_covariance":best["O"].tolist(),"best_bic":best["bic"],"runner_up_gap":gap,"pair_ranking":[{"pair":d["pair"],"bic":d["bic"],"n_edges":len(d["edges"])} for d in candidates],"max_mean_error":max(errors),"p90_mean_error":float(np.quantile(errors,.9)),"gradient":best["gradient"],"success":best["success"]}))
print("WITNESS_ANSWER","yes" if gap>=10 and len(best["edges"])<=10 and best["success"] and max(errors)<=.25 else "no")
