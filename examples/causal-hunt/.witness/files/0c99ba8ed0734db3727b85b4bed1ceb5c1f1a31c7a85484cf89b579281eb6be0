import os,json,numpy as np,matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
a=np.loadtxt("observational.csv",delimiter=",",skiprows=1);assert a.shape==(2000,6)
T=np.eye(6);S=np.zeros((6,6));records=[]
for k,(j,v) in enumerate([(0,2),(3,3),(2,-3),(1,3),(4,3),(5,-3)],1):
 b=np.loadtxt(f"data/exp{k}.csv",delimiter=",",skiprows=1);assert b.shape==(500,6) and np.allclose(b[:,j],v)
 d=b.mean(0)-a.mean(0);se=np.sqrt(a.var(0,ddof=1)/len(a)+b.var(0,ddof=1)/len(b))
 T[:,j]=d/(v-a.mean(0)[j]);S[:,j]=se/abs(v-a.mean(0)[j])
 records.append({"file":f"data/exp{k}.csv","do":{f"x{j+1}":v},"means":b.mean(0).tolist(),"descendants":[f"x{i+1}" for i in range(6) if i!=j and abs(d[i])>max(.15,4*se[i])]})
B=np.eye(6)-np.linalg.inv(T);out=os.environ["WITNESS_OUT"]
json.dump({"T":T.tolist(),"B":B.tolist(),"SE":S.tolist(),"regimes":records},open(out+"/total_effects.json","w"))
fig,axs=plt.subplots(1,2,figsize=(12,5))
for ax,A,title in zip(axs,[T,B],["Total effect: column cause","Inverted direct effects (noisy)"]):
 im=ax.imshow(A,cmap="RdBu_r",vmin=-1.5,vmax=1.5);ax.set_title(title);ax.set_xticks(range(6),[f"x{i+1}" for i in range(6)]);ax.set_yticks(range(6),[f"x{i+1}" for i in range(6)])
 for i in range(6):
  for j in range(6):ax.text(j,i,f"{A[i,j]:.2f}",ha="center",va="center")
fig.tight_layout();fig.savefig(out+"/effects_graph.png")
print("WITNESS_RESULT",json.dumps({"T":T.round(3).tolist(),"B":B.round(3).tolist(),"x6_descendants":records[-1]["descendants"]}))
print("WITNESS_ANSWER","yes" if abs(T[0,5])>.8 and records[-1]["descendants"]==["x1"] and np.isfinite(B).all() else "no")
