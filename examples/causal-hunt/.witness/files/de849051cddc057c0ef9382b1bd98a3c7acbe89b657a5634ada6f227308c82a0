import os,json,numpy as np
d=json.load(open("q-7ff48a2acb33/total_effects.json"));assert os.path.getsize("q-7ff48a2acb33/effects_graph.png")>0
T=np.array(d["T"]);B=np.array(d["B"]);assert T.shape==B.shape==(6,6)
edges=lambda A:{(f"x{j+1}",f"x{i+1}") for i in range(6) for j in range(6) if i!=j and abs(A[i,j])>.2}
t=edges(T);b=edges(B);r={"total_graph":sorted(t),"direct_candidate":sorted(b),"mediated_not_direct":sorted(t-b),"cancelled_direct":sorted(b-t)}
json.dump(r,open(os.environ["WITNESS_OUT"]+"/graph_comparison.json","w"));print("WITNESS_RESULT",json.dumps(r));print("WITNESS_ANSWER","yes" if t==b else "no")
