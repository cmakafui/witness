# requires-python = ">=3.11"
# dependencies = ["numpy==2.3.4","matplotlib==3.10.7"]
# ///
import numpy as np,json,os,matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
a=np.loadtxt("observational.csv",delimiter=",",skiprows=1);assert a.shape==(2000,6)
records=[];effects=[]
for filename,j,v in [("data/exp1.csv",0,2),("data/exp2.csv",3,3)]:
 b=np.loadtxt(filename,delimiter=",",skiprows=1);assert b.shape==(500,6) and np.allclose(b[:,j],v)
 d=b.mean(0)-a.mean(0);se=np.sqrt(a.var(0,ddof=1)/len(a)+b.var(0,ddof=1)/len(b))
 desc=[i for i in range(6) if i!=j and abs(d[i])>max(.15,4*se[i])]
 e=d/(v-a.mean(0)[j]);effects.append(e)
 records.append({"file":filename,"do":{f"x{j+1}":v},"means":b.mean(0).tolist(),"cov":np.cov(b,rowvar=False).tolist(),"effects":e.tolist(),"se_effect":(se/abs(v-a.mean(0)[j])).tolist(),"descendants":[f"x{i+1}" for i in desc]})
out=os.environ["WITNESS_OUT"];json.dump(records,open(out+"/regimes.json","w"))
fig,ax=plt.subplots(figsize=(8,3));im=ax.imshow(effects,cmap="RdBu_r",vmin=-2,vmax=2)
ax.set_yticks([0,1],["do(x1=2)","do(x4=3)"]);ax.set_xticks(range(6),[f"x{i+1}" for i in range(6)])
for i,row in enumerate(effects):
 for j,x in enumerate(row):ax.text(j,i,f"{x:.2f}",ha="center",va="center")
fig.colorbar(im);fig.tight_layout();fig.savefig(out+"/effects.png")
print("WITNESS_RESULT",json.dumps(records))
print("WITNESS_ANSWER","yes" if len(records[0]["descendants"])==0 and len(records[1]["descendants"])>=2 else "no")
