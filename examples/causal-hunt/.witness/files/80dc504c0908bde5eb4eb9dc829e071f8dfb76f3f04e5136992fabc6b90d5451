import numpy as np, json, os
from sklearn.preprocessing import SplineTransformer
from sklearn.linear_model import LinearRegression,Ridge
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
x=np.genfromtxt('observational.csv',delimiter=',',names=True)
names=list(x.dtype.names); X=np.column_stack([x[n] for n in names]); assert X.shape==(2000,6) and np.isfinite(X).all()
rows=[]; residuals=[]
fig,axs=plt.subplots(2,3,figsize=(12,7))
for j in range(6):
 ids=[i for i in range(6) if i!=j]; a=X[:,ids]; y=X[:,j]
 lin=LinearRegression().fit(a[:1500],y[:1500]); pred=lin.predict(a[1500:]); ml=float(np.mean((y[1500:]-pred)**2))
 sp=SplineTransformer(n_knots=5,degree=3).fit(a[:1500]); z=sp.transform(a); spl=Ridge(alpha=.1).fit(z[:1500],y[:1500]); ps=spl.predict(z[1500:]); ms=float(np.mean((y[1500:]-ps)**2))
 rows.append({'target':names[j],'linear_mse':ml,'spline_mse':ms,'ratio':ms/ml,'linear_coef':dict(zip([names[i] for i in ids],lin.coef_.tolist())),'intercept':float(lin.intercept_)})
 residuals.append(y-lin.predict(a)); axs.flat[j].scatter(pred,y[1500:]-pred,s=6,alpha=.4);axs.flat[j].set_title(names[j]+' linear residual');axs.flat[j].axhline(0,color='r')
fig.tight_layout();fig.savefig(os.path.join(os.environ['WITNESS_OUT'],'linear_residuals.png'))
np.save(os.path.join(os.environ['WITNESS_OUT'],'linear_residuals.npy'),np.array(residuals).T)
json.dump(rows,open(os.path.join(os.environ['WITNESS_OUT'],'association_fits.json'),'w'),indent=2)
print('WITNESS_RESULT',json.dumps(rows));assert all(r['linear_mse']>0 and r['spline_mse']>0 for r in rows)
print('WITNESS_ANSWER','yes' if min(r['ratio'] for r in rows)<.9 else 'no')