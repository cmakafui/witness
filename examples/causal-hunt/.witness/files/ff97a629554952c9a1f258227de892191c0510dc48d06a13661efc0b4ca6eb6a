import os,json,numpy as np,matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import networkx as nx
d=json.load(open("q-c922af4201cf/candidate_fits.json"))[0];B=np.array(d["B"]);a=np.array(d["a"])
files=["observational.csv"]+[f"data/exp{i}.csv" for i in range(1,7)];fixed=[[],[0],[3],[2],[1],[4],[5]];rs=[];means=[]
for file,fix in zip(files,fixed):
 x=np.loadtxt(file,delimiter=",",skiprows=1);assert x.shape[1]==6 and len(x)>=500
 r=x-x@B.T-a;r[:,fix]=np.nan;rs.append(r);means.append(np.nanmean(r,axis=0))
r=np.concatenate(rs);corr=np.eye(6)
for i in range(6):
 for j in range(i):
  ok=np.isfinite(r[:,i])&np.isfinite(r[:,j]);assert ok.sum()>1000;corr[i,j]=corr[j,i]=np.corrcoef(r[ok,i],r[ok,j])[0,1]
other=[abs(corr[i,j]) for i in range(6) for j in range(i) if (j,i)!=(0,1)]
out=os.environ["WITNESS_OUT"];fig,axes=plt.subplots(1,3,figsize=(15,5))
axes[0].imshow(corr,vmin=-1,vmax=1,cmap="RdBu_r");axes[0].set_title("Available-case residual correlation")
for i in range(6):
 for j in range(6):axes[0].text(j,i,f"{corr[i,j]:.2f}",ha="center",va="center",fontsize=8)
axes[0].set_xticks(range(6),[f"x{i+1}" for i in range(6)]);axes[0].set_yticks(range(6),[f"x{i+1}" for i in range(6)])
axes[1].imshow(np.array(means),vmin=-.25,vmax=.25,cmap="RdBu_r");axes[1].set_title("Residual means; gray=intervened")
axes[1].set_yticks(range(7),["passive"]+[f"exp{i}" for i in range(1,7)]);axes[1].set_xticks(range(6),[f"x{i+1}" for i in range(6)])
G=nx.DiGraph();G.add_nodes_from(range(6));G.add_edges_from(d["edges"])
pos={1:(0,0),2:(1,1),3:(2,1),4:(1,-1),5:(2,-1),0:(3,0)}
nx.draw_networkx(G,pos,labels={i:f"x{i+1}" for i in range(6)},ax=axes[2],arrows=True,node_color="#b9ddf0",node_size=900)
axes[2].plot([0,3],[0,0],"--",color="orange",label="x1 ↔ x2 residual");axes[2].legend(loc="upper left",fontsize=8);axes[2].set_axis_off();axes[2].set_title("Directed graph + latent common influence")
fig.tight_layout();fig.savefig(out+"/residual_graph.png",dpi=160)
result={"correlations":corr.tolist(),"max_other_abs_correlation":max(other),"max_abs_residual_mean":float(np.nanmax(np.abs(means)))}
json.dump(result,open(out+"/residual_checks.json","w"));print("WITNESS_RESULT",json.dumps(result))
print("WITNESS_ANSWER","yes" if max(other)>.1 or np.nanmax(np.abs(means))>.25 else "no")
