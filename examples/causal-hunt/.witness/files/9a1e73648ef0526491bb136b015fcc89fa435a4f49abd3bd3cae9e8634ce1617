import os,json,numpy as np
a=np.loadtxt("observational.csv",delimiter=",",skiprows=1);b=np.loadtxt("data/exp3.csv",delimiter=",",skiprows=1);assert a.shape==(2000,6) and b.shape==(500,6) and np.allclose(b[:,2],-3)
d=b.mean(0)-a.mean(0);se=np.sqrt(a.var(0,ddof=1)/len(a)+b.var(0,ddof=1)/len(b));effects=d/(-3-a.mean(0)[2]);flag=[i for i in range(6) if i!=2 and abs(d[i])>max(.15,4*se[i])]
r={"do":{"x3":-3},"means":b.mean(0).tolist(),"effects":effects.tolist(),"se_effect":(se/abs(-3-a.mean(0)[2])).tolist(),"descendants":[f"x{i+1}" for i in flag]}
json.dump(r,open(os.environ["WITNESS_OUT"]+"/effects.json","w"));print("WITNESS_RESULT",json.dumps(r));print("WITNESS_ANSWER","yes" if len(flag)==5 else "no")
