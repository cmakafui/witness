import os,json,itertools,importlib.util,numpy as np
spec=importlib.util.spec_from_file_location("jf","q-c922af4201cf/joint_fit.py");jf=importlib.util.module_from_spec(spec);spec.loader.exec_module(jf)
d=json.load(open("q-c922af4201cf/candidate_fits.json"))[0]
files=["observational.csv"]+[f"data/exp{i}.csv" for i in range(1,7)];fixed=[{}, {0:2},{3:3},{2:-3},{1:3},{4:3},{5:-3}]
