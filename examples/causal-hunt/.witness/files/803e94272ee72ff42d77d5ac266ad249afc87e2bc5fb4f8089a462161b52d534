 prior=order[:order.index(j)];x=np.concatenate([x for x,s in regimes if j not in s]);trials=[]
 for mask in range(1<<len(prior)):
  pp=[p for k,p in enumerate(prior) if (mask>>k)&1];X=np.column_stack([np.ones(len(x)),x[:,pp]]);b=np.linalg.lstsq(X,x[:,j],rcond=None)[0];rss=np.sum((x[:,j]-X@b)**2)
  score=len(x)*np.log(rss/len(x))+(2+len(pp))*np.log(N);trials.append({"target":j,"parents":pp,"bic":float(score)})
 trials.sort(key=lambda t:t["bic"]);chosen.extend((i,j) for i in trials[0]["parents"]);scores.extend(trials)
