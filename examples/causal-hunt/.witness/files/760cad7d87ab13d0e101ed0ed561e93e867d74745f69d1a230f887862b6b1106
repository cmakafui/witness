import numpy as np,json,os
from PIL import Image
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
im=Image.open('q-7ff48a2acb33/effects_graph.png');assert im.width>100
info=json.load(open('q-7ff48a2acb33/total_effects.json'));assert len(info['regimes'])==6
raw=np.genfromtxt('observational.csv',delimiter=',',names=True);names=list(raw.dtype.names);X=np.column_stack([raw[n] for n in names]);assert X.shape==(2000,6)
parents=[[1,2,3,5],[],[1],[2],[1],[4]];B=np.zeros((6,6));a=np.zeros(6)
for j,p in enumerate(parents):
 z=np.column_stack([np.ones(len(X)),X[:,p]]);coef=np.linalg.lstsq(z,X[:,j],rcond=None)[0];a[j]=coef[0];B[j,p]=coef[1:]
rows=[];errs=[]
for reg in info['regimes']:
 d=np.genfromtxt(reg['file'],delimiter=',',names=True);Y=np.column_stack([d[n] for n in names]);assert Y.shape==(500,6)
 bs=B.copy();aa=a.copy();setids=[]
 for name,value in reg['do'].items():
  j=names.index(name);bs[j]=0;aa[j]=value;setids.append(j)
 pred=np.linalg.solve(np.eye(6)-bs,aa);err=pred-Y.mean(0);idx=[j for j in range(6) if j not in setids];errs.extend(abs(err[idx]).tolist());rows.append({'do':reg['do'],'prediction':pred.tolist(),'empirical':Y.mean(0).tolist(),'error':err.tolist()})
Biv=np.array(info['B']);mask=np.zeros((6,6))
for j,p in enumerate(parents):mask[j,p]=1
Biv*=mask;R=X-X@Biv.T;R-=R.mean(0);cov=np.cov(R,rowvar=False);corr=np.corrcoef(R,rowvar=False);ols=X-X@B.T-a
pairs=sorted([{'pair':[names[i],names[j]],'correlation':float(corr[i,j]),'covariance':float(cov[i,j])} for i in range(6) for j in range(i)],key=lambda r:abs(r['correlation']),reverse=True)
result={'passive_OLS_B':B.tolist(),'passive_OLS_intercept':a.tolist(),'interventions':rows,'max_nonset_error':max(errs),'p90_nonset_error':float(np.quantile(errs,.9)),'structural_residual_pairs':pairs,'naive_OLS_residual_correlation':np.corrcoef(ols,rowvar=False).tolist()}
json.dump(result,open(os.path.join(os.environ['WITNESS_OUT'],'ols_falsification.json'),'w'),indent=2)
fig,ax=plt.subplots(figsize=(6,5));im=ax.imshow(corr,vmin=-1,vmax=1,cmap='RdBu_r');ax.set_xticks(range(6),names);ax.set_yticks(range(6),names)
for i in range(6):
 for j in range(6):ax.text(j,i,f'{corr[i,j]:.2f}',ha='center',va='center')
fig.colorbar(im);fig.tight_layout();fig.savefig(os.path.join(os.environ['WITNESS_OUT'],'structural_residual_correlation.png'))
print('WITNESS_RESULT',json.dumps(result));print('WITNESS_ANSWER','yes' if max(errs)<=.3 else 'no')