# dependencies = ["numpy==2.3.4"]
# ///
import os,json,ast,itertools,importlib.util,numpy as np
raw=open("model.py","rb").read();assert raw==open("q-ebcc3cc1a5a3/model.py","rb").read()
tree=ast.parse(raw)
for node in ast.walk(tree):
 if isinstance(node,ast.Import):assert all(n.name=="numpy" or n.name in {"math","json","copy","itertools","typing"} for n in node.names)
 if isinstance(node,ast.ImportFrom):assert node.module in {"math","typing","numpy","copy","itertools"}
spec=importlib.util.spec_from_file_location("m","model.py");m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
designs=[{}]
for n in [1,2]:
 for inds in itertools.combinations(range(6),n):
  for vals in itertools.product([-3.,-1.,1.,3.],repeat=n):designs.append({f"x{i+1}":v for i,v in zip(inds,vals)})
assert len(designs)==265
records=[];err=0.;ok=True
for do in designs:
 p=m.intervene(do);y=np.array([p[f"x{i+1}"] for i in range(6)]);A=np.eye(6)-m._B;b=m._A.copy()
 for name,v in do.items():
  i=int(name[1:])-1;A[i]=0;A[i,i]=1;b[i]=v;ok=ok and p[name]==v
 ref=np.linalg.solve(A,b);err=max(err,float(np.max(abs(y-ref))));ok=ok and np.isfinite(y).all()
 records.append({"do":do,"expected":p})
out=os.environ["WITNESS_OUT"];open(out+"/model.py","wb").write(raw);json.dump(records,open(out+"/intervention_predictions.json","w"),indent=2)
print("WITNESS_RESULT",json.dumps({"n_designs":len(designs),"max_algebra_error":err,"examples":[r for r in records if r["do"] in [{"x2":1.,"x4":-3.},{"x3":3.,"x5":-3.}]]}))
print("WITNESS_ANSWER","yes" if ok and err<=1e-12 else "no")
