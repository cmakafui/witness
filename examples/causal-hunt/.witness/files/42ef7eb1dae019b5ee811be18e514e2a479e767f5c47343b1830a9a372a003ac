import numpy as np,json,os
x=np.genfromtxt('observational.csv',delimiter=',',names=True);names=list(x.dtype.names);a=np.column_stack([x[n] for n in names]);c=np.load('q-c10680895529/correlation.npy');assert a.shape==(2000,6) and c.shape==(6,6)
s=np.cov(a,rowvar=False);m=a.mean(0);models=[]
for order in [list(range(6)),list(reversed(range(6)))]:
 b=np.zeros((6,6));d=np.zeros(6)
 for k,j in enumerate(order):
  pa=order[:k];b[j,pa]=np.linalg.solve(s[np.ix_(pa,pa)],s[pa,j]) if pa else [];d[j]=s[j,j]-b[j]@s[:,j]
 g=np.linalg.inv(np.eye(6)-b);err=float(np.max(abs(g@np.diag(d)@g.T-s)));intercept=(np.eye(6)-b)@m
 pred=[]
 for j in range(6):
  bb=b.copy();aa=intercept.copy();bb[j]=0;aa[j]=2;pred.append(np.linalg.solve(np.eye(6)-bb,aa).tolist())
 models.append({'order':[names[j] for j in order],'B':b.tolist(),'intercept':intercept.tolist(),'variance':d.tolist(),'covariance_error':err,'singleton_do2':pred})
diff=abs(np.array(models[0]['singleton_do2'])-np.array(models[1]['singleton_do2']));np.fill_diagonal(diff,0);out=os.environ['WITNESS_OUT'];json.dump(models,open(out+'/equivalent_models.json','w'),indent=2)
print('WITNESS_RESULT',json.dumps({'covariance_errors':[z['covariance_error'] for z in models],'max_intervention_disagreement':float(diff.max()),'disagreement':diff.tolist()}));print('WITNESS_ANSWER','yes' if all(z['covariance_error']<=1e-10 for z in models) and diff.max()>.3 else 'no')