# /// script
# requires-python = ">=3.11"
# dependencies = ["numpy==2.3.4","matplotlib==3.10.7"]
# ///
import os,json,hashlib,importlib.util,numpy as np,matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
raw=open("model.py","rb").read();frozen=open("q-c922af4201cf/model.py","rb").read();design=json.load(open("q-97336532cc30/heldout_design.json"))
assert raw==frozen and hashlib.sha256(raw).hexdigest()==design["sha256"]
spec=importlib.util.spec_from_file_location("m","model.py");m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
expected={("x2","x3"),("x2","x5"),("x2","x1"),("x3","x4"),("x3","x1"),("x4","x1"),("x5","x6"),("x6","x1")}
g=m.graph();graph_ok=set(map(tuple,g["edges"]))==expected and set(map(tuple,g["confounded"]))=={("x1","x2")}
settings=[{"x1":2},{"x4":3},{"x3":-3},{"x2":3},{"x5":3},{"x6":-3},design["do"]]
errs=[];records=[];matrix=np.full((7,6),np.nan);honors=True
for k,do in enumerate(settings,1):
 x=np.loadtxt(f"data/exp{k}.csv",delimiter=",",skiprows=1);assert x.shape==(500,6) and np.isfinite(x).all()
 p=m.intervene(do);assert set(p)=={f"x{i+1}" for i in range(6)} and all(np.isfinite(v) for v in p.values())
 mu=x.mean(0);se=x.std(0,ddof=1)/np.sqrt(len(x));item={"regime":k,"do":do,"fitted":k<=6,"predicted":p,"measured":mu.tolist(),"sample_mean_SE":se.tolist()}
 ee=[]
 for j in range(6):
  name=f"x{j+1}"
  if name in do:honors=honors and p[name]==do[name] and np.allclose(x[:,j],do[name])
  else:
   e=abs(p[name]-mu[j]);errs.append(e);ee.append(e);matrix[k-1,j]=e
 item["max_error"]=max(ee);records.append(item)
log=open("experiments.log").read();assert log.strip()
try:
 parsed=json.loads(log);count=len(parsed) if isinstance(parsed,list) else 1
except json.JSONDecodeError:count=len([s for s in log.splitlines() if s.strip()])
assert count>0
out=os.environ["WITNESS_OUT"];p90=float(np.quantile(errs,.9));maximum=float(max(errs))
r={"graph":g,"n_experiments":count,"n_unset_comparisons":len(errs),"p90_error":p90,"max_error":maximum,"heldout":records[-1],"regimes":records,"scope":"Seven measured regimes; exp7 excluded from fitting. No judge access, no certification of all possible interventions."}
json.dump(r,open(out+"/certificate.json","w"),indent=2);open(out+"/model.py","wb").write(raw)
fig,ax=plt.subplots(figsize=(9,6));im=ax.imshow(matrix,cmap="YlOrRd",vmin=0,vmax=.3)
ax.set_xticks(range(6),[f"x{i+1}" for i in range(6)]);ax.set_yticks(range(7),[str(d)+(" HOLDOUT" if i==6 else "") for i,d in enumerate(settings)])
for i in range(7):
 for j in range(6):
  if np.isfinite(matrix[i,j]):ax.text(j,i,f"{matrix[i,j]:.3f}",ha="center",va="center")
ax.set_title("Absolute error against 500-row measured mean");fig.colorbar(im);fig.tight_layout();fig.savefig(out+"/validation.png")
print("WITNESS_RESULT",json.dumps({"n_experiments":count,"p90_error":p90,"max_error":maximum,"heldout":records[-1],"graph_ok":graph_ok,"honors_interventions":honors,"sha256":design["sha256"]}))
print("WITNESS_ANSWER","yes" if graph_ok and honors and count<=7 and maximum<=.3 and p90<=.3 else "no")
