import numpy as np,json,itertools,os
from scipy.stats import spearmanr,pearsonr
assert open('q-12f026f7acf2/structural_residuals.png','rb').read(8)==b'\x89PNG\r\n\x1a\n'
r=np.load('q-12f026f7acf2/structural_residuals.npy');assert r.shape==(2000,6);r=r-r.mean(0);rows=[]
for i,j in itertools.combinations(range(6),2):
 if (i,j)==(0,1):continue
 rho,p=spearmanr(r[:,i],r[:,j]);sq,psq=pearsonr(r[:,i]**2,r[:,j]**2);rows.append({'pair':[f'x{i+1}',f'x{j+1}'],'spearman':float(rho),'spearman_p':float(p),'square_r':float(sq),'square_p':float(psq),'crossed':bool((abs(rho)>.1 and p<.001) or (abs(sq)>.1 and psq<.001))})
